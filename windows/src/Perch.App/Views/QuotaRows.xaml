<!-- macOS: QuotaRow.swift -->
<UserControl x:Class="Perch.Windows.QuotaRows" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Perch.Windows" >
<!-- The label column grows to the widest label in the card ("Sonnet 周"), never below the 5h/周 width. -->
<StackPanel><ItemsControl ItemsSource="{Binding Quotas}" Grid.IsSharedSizeScope="True"><ItemsControl.ItemTemplate><DataTemplate>
 <Grid Margin="0,0,0,6" ToolTip="{Binding Tip}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="24" SharedSizeGroup="QuotaLabel"/><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextSecondary}" TextWrapping="NoWrap" Margin="0,0,8,0"/>
 <TextBlock Grid.Column="1" Text="{Binding Percent}" Typography.NumeralAlignment="Tabular" local:ColorToken.Key="{Binding ColorKey}"/>
 <TextBlock Grid.Column="2" Text="{Binding Reset}" Style="{StaticResource Meta}" HorizontalAlignment="Right"/>
 </Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 <TextBlock Text="官方登录钱包" FontWeight="SemiBold" Margin="0,2,0,6" Visibility="{Binding HasWallets, Converter={StaticResource BoolVisibility}}"/>
 <ItemsControl ItemsSource="{Binding Wallets}"><ItemsControl.ItemTemplate><DataTemplate>
  <DockPanel Margin="0,0,0,6"><TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextSecondary}"/><TextBlock Text="{Binding Amount}" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"/></DockPanel>
 </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 <StackPanel Visibility="{Binding HasApiBalance, Converter={StaticResource BoolVisibility}}">
  <TextBlock Text="DeepSeek API 余额" FontWeight="SemiBold" Margin="0,4,0,6"/>
  <ItemsControl ItemsSource="{Binding ApiWallets}"><ItemsControl.ItemTemplate><DataTemplate>
   <DockPanel Margin="0,0,0,6"><TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextSecondary}"/><TextBlock Text="{Binding Amount}" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"/></DockPanel>
  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  <TextBlock Text="{Binding ApiBalanceDetail}" Style="{StaticResource Meta}" Margin="0,0,0,6"/>
 </StackPanel></StackPanel>
</UserControl>
